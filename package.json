{
  "name": "gabriel-santos-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Gabriel Santos' portfolio: a film in three acts.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "tsx scripts/preview.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/unit/*.test.ts",
    "todos": "tsx scripts/list-todos.ts",
    "gate": "tsx scripts/gate-screenshots.ts",
    "test:e2e": "playwright test",
    "measure:js": "tsx scripts/measure-js.ts",
    "measure:vitals": "tsx scripts/measure-vitals.ts"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "motion": "14.1.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
